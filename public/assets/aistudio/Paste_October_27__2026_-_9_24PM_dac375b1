function loginCustomer(e){e.preventDefault();let identity=document.getElementById('loginIdentity').value.trim().toLowerCase(),password=document.getElementById('loginPassword').value;let c=customers.find(x=>(x.email.toLowerCase()===identity||x.phone.toLowerCase()===identity)&&x.password===password);if(!c)return toast('Thông tin đăng nhập chưa chính xác');if(!c.memberCode)c.memberCode='TTTV-'+Math.random().toString(36).slice(2,7).toUpperCase();activeCustomer=c;persistCustomers();e.target.reset();renderAccount();showAppAfterAuth();toast('Đăng nhập thành công! Xin chào '+c.name)}
function logoutCustomer(){activeCustomer=null;rememberSession=false;localStorage.removeItem('tt_active_customer');localStorage.removeItem('tt_remember_login');renderAccount();document.body.classList.add('auth-mode');switchGateTab('login');toast('Bạn đã đăng xuất')}
function renderAccount(){let out=document.getElementById('accountLoggedOut'),inside=document.getElementById('accountLoggedIn');out.classList.toggle('hidden',!!activeCustomer);inside.classList.toggle('hidden',!activeCustomer);if(!activeCustomer)return;let c=customers.find(x=>x.id===activeCustomer.id)||activeCustomer;activeCustomer=c;document.getElementById('profileName').textContent=c.name;document.getElementById('profileAvatar').src=c.avatar||avatarPlaceholder();document.getElementById('profileIdentity').textContent=c.email+' · '+c.phone;document.getElementById('profileMemberCode').textContent=c.memberCode||(c.memberCode='TTTV-'+Math.random().toString(36).slice(2,7).toUpperCase());persistCustomers();document.getElementById('profileEditName').value=c.name||'';document.getElementById('profileEditPhone').value=c.phone||'';document.getElementById('profileEditAddress').value=c.address||'';document.getElementById('profileOrders').textContent=orders.filter(o=>o.customerId===c.id||o.phone===c.phone).length;document.getElementById('profilePackages').textContent=packages.filter(p=>p.customerId===c.id).length}
function saveProfile(){if(!activeCustomer)return;let c=customers.find(x=>x.id===activeCustomer.id)||activeCustomer,name=document.getElementById('profileEditName').value.trim(),phone=document.getElementById('profileEditPhone').value.trim();if(!name||!phone)return toast('Vui lòng nhập họ tên và số điện thoại');if(customers.some(x=>x.id!==c.id&&x.phone===phone))return toast('Số điện thoại đã được sử dụng');c.name=name;c.phone=phone;c.address=document.getElementById('profileEditAddress').value.trim();activeCustomer=c;persistCustomers();renderAccount();toast('Đã lưu thông tin tài khoản')}

function avatarPlaceholder(){return 'data:image/svg+xml;charset=UTF-8,'+encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" width="120" height="120" viewBox="0 0 120 120"><rect width="120" height="120" rx="60" fill="#eaf5ef"/><circle cx="60" cy="43" r="22" fill="#8ebaa1"/><path d="M20 112c3-25 19-38 40-38s37 13 40 38" fill="#8ebaa1"/></svg>')}
function renderCustomerSettings(){if(!activeCustomer){toast('Vui lòng đăng nhập để mở cài đặt');go('account');return}let c=customers.find(x=>x.id===activeCustomer.id)||activeCustomer;document.getElementById('settingsAvatarPreview').src=c.avatar||avatarPlaceholder();document.getElementById('settingsAvatarName').textContent=c.name||'Ảnh đại diện của bạn';document.getElementById('customerLanguage').value=localStorage.getItem('tt_customer_language')||'vi';}
function uploadCustomerAvatar(e){let f=e.target.files&&e.target.files[0];if(!f)return;if(f.size>2*1024*1024){toast('Ảnh tối đa 2 MB');e.target.value='';return}if(!/^image\/(png|jpeg|webp)$/.test(f.type)){toast('Vui lòng chọn ảnh PNG, JPG hoặc WebP');return}let r=new FileReader();r.onload=()=>{let c=customers.find(x=>x.id===activeCustomer.id)||activeCustomer;c.avatar=r.result;activeCustomer=c;persistCustomers();document.getElementById('settingsAvatarPreview').src=r.result;document.getElementById('settingsAvatarName').textContent=c.name||'Ảnh đại diện';let pa=document.getElementById('profileAvatar');if(pa)pa.src=r.result;toast('Đã cập nhật ảnh đại diện')};r.readAsDataURL(f)}
function changeCustomerPassword(e){e.preventDefault();if(!activeCustomer)return;let c=customers.find(x=>x.id===activeCustomer.id)||activeCustomer,old=document.getElementById('currentCustomerPassword').value,nw=document.getElementById('newCustomerPassword').value,cf=document.getElementById('confirmCustomerPassword').value;if(old!==c.password)return toast('Mật khẩu hiện tại chưa chính xác');if(nw.length<6)return toast('Mật khẩu mới cần ít nhất 6 ký tự');if(nw!==cf)return toast('Mật khẩu xác nhận không khớp');c.password=nw;activeCustomer=c;persistCustomers();e.target.reset();toast('Đổi mật khẩu thành công')}
const customerTextVI={'Trang chủ':'Home','Thực đơn':'Menu','Đơn hàng của tôi':'My Orders','Gói suất ăn':'Meal Packages','Tài khoản':'Account','Cài đặt':'Settings','Giỏ hàng':'Cart','Cập nhật mật khẩu':'Update password','Đổi mật khẩu':'Change password','Ảnh đại diện':'Profile photo','Ngôn ngữ':'Language','Ngôn ngữ ứng dụng':'App language','Quay lại tài khoản':'Back to account'};
function setCustomerLanguage(lang){localStorage.setItem('tt_customer_language',lang);document.documentElement.lang=lang;document.querySelectorAll('.nav [data-page]').forEach(b=>{let vi={'home':'Trang chủ','menu':'Thực đơn','orders':'Đơn hàng của tôi','member':'Gói suất ăn','account':'Tài khoản','settings':'Cài đặt','checkout':'Giỏ hàng'}[b.dataset.page];if(!b.dataset.originalLabel)b.dataset.originalLabel=vi;b.childNodes[0].textContent=(lang==='en'?(customerTextVI[vi]||vi):vi)+' ';});let t=document.querySelector('#page-settings .sectionhead h2'),p=document.querySelector('#page-settings .sectionhead p');if(t)t.textContent=lang==='en'?'Settings':'Cài đặt';if(p)p.textContent=lang==='en'?'Customize your account and Tới Trưa experience.':'Tuỳ chỉnh tài khoản và trải nghiệm sử dụng Tới Trưa.';let labels={'Ảnh đại diện':'Profile photo','Đổi mật khẩu':'Change password','Mật khẩu hiện tại':'Current password','Mật khẩu mới (ít nhất 6 ký tự)':'New password (at least 6 characters)','Xác nhận mật khẩu mới':'Confirm new password','Cập nhật mật khẩu':'Update password','Ngôn ngữ':'Language','Ngôn ngữ ứng dụng':'App language','Quay lại tài khoản':'Back to account'};document.querySelectorAll('#page-settings h3,#page-settings label,#page-settings button').forEach(el=>{if(!el.dataset.viText)el.dataset.viText=el.textContent.trim();let vi=el.dataset.viText;el.textContent=lang==='en'?(labels[vi]||vi):vi});}
if(!localStorage.getItem('tt_custom_menu'))localStorage.setItem('tt_custom_menu',JSON.stringify(customMenu));initDays();renderFoods();setCustomerLanguage(localStorage.getItem('tt_customer_language')||'vi');document.getElementById('useDay').value=activeDay;renderCart();if(activeCustomer){document.body.classList.remove('auth-mode');renderAccount()}else{document.body.classList.add('auth-mode');switchGateTab('login')}
</script>
