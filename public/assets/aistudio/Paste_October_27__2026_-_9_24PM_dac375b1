  <div class="auth-form-side"><div class="auth-card">
    <div class="tabs"><button class="active" type="button" data-gate-tab="login">Đăng nhập</button><button type="button" data-gate-tab="register">Đăng ký</button></div>
    <form id="gateLoginForm" onsubmit="gateLoginCustomer(event)"><h2>Chào mừng trở lại 👋</h2><p class="sub">Đăng nhập để tiếp tục đặt bữa trưa.</p>
      <div class="field"><label>Email hoặc số điện thoại</label><input id="gateLoginIdentity" autocomplete="username" placeholder="email@example.com hoặc số điện thoại" required></div>
      <div class="field"><label>Mật khẩu</label><input id="gateLoginPassword" type="password" autocomplete="current-password" placeholder="Nhập mật khẩu" minlength="6" required></div>
      <label class="remember-row"><input type="checkbox" id="rememberLogin" checked> Ghi nhớ đăng nhập trên thiết bị này</label>
      <button class="primary full" type="submit">Đăng nhập và vào trang chủ →</button>
    </form>
    <form id="gateRegisterForm" class="hidden" onsubmit="gateRegisterCustomer(event)"><h2>Tạo tài khoản mới ✨</h2><p class="sub">Đăng ký để bắt đầu hành trình bữa trưa.</p>
