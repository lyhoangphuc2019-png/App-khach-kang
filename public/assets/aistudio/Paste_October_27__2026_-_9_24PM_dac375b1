else if(adminTab==='kitchen'){let day=document.getElementById('kitchenDay')?.value||dayOptions[0].value;let sums={};orders.filter(o=>o.day===day&&o.status!=='Đã hủy').forEach(o=>o.items.forEach(i=>sums[i.name]=(sums[i.name]||0)+i.qty));el.innerHTML=`<div class="panel"><div class="sectionhead"><div><h3>Danh sách suất ăn cần chuẩn bị</h3><p>Tổng hợp từ các đơn đặt trước chưa bị hủy.</p></div><div class="field" style="min-width:190px;margin:0"><label>Ngày sử dụng</label><select id="kitchenDay" onchange="renderAdmin()">${dayOptions.map(d=>`<option value="${d.value}" ${d.value===day?'selected':''}>${d.label}</option>`).join('')}</select></div></div>${Object.keys(sums).length?Object.entries(sums).map(([name,n])=>`<div class="cartline"><b>${name}</b><b>${n} suất</b></div>`).join(''):'<div class="empty">Chưa có suất ăn được đặt cho ngày này.</div>'}</div>`}
