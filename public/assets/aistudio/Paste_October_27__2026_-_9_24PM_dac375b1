else{let delivered=orders.filter(o=>o.status==='Đã giao').length,cancelled=orders.filter(o=>o.status==='Đã hủy').length,paid=orders.filter(o=>o.status==='Đã giao').reduce((s,o)=>s+(Number(o.total)||0),0);el.innerHTML=`<div class="metricgrid"><div class="metric"><span>Tổng đơn</span><strong>${orders.length}</strong></div><div class="metric"><span>Đã giao</span><strong>${delivered}</strong></div><div class="metric"><span>Đã hủy</span><strong>${cancelled}</strong></div><div class="metric"><span>Đã thanh toán</span><strong style="font-size:17px">${fmt(paid)}</strong></div></div><div class="panel"><h3>Báo cáo doanh thu và đơn hàng</h3><div class="cartline"><span>Doanh thu đơn hàng thành công (đã giao)</span><b>${fmt(total)}</b></div><div class="cartline"><span>Phí giao hàng đã tính</span><b>${fmt(orders.reduce((s,o)=>s+o.shipping,0))}</b></div><div class="cartline"><span>Số đơn đang xử lý</span><b>${active}</b></div><div class="cartline"><span>Số suất ăn trong các đơn chưa hủy</span><b>${orders.filter(o=>o.status!=='Đã hủy').reduce((s,o)=>s+o.items.reduce((a,i)=>a+i.qty,0),0)}</b></div><p style="font-size:12px;color:var(--muted)">Báo cáo demo được tính từ dữ liệu đơn hàng đang lưu trên trình duyệt.</p><button class="secondary" onclick="exportCSV()">Xuất báo cáo CSV</button></div>`}}
function updateStatus(id,s){let o=orders.find(x=>x.id===id);if(o){o.status=s;if(s==='Đã giao')o.payStatus=o.payment.startsWith('Thanh toán khi nhận')?'Đã thanh toán':o.payStatus;save();renderAdmin();toast('Đã cập nhật trạng thái đơn')}}
function addFood(){let name=document.getElementById('newFoodName').value.trim(),price=Number(document.getElementById('newFoodPrice').value),cat=document.getElementById('newFoodCat').value,emoji=document.getElementById('newFoodEmoji').value||'🍱';if(!name||price<1000)return toast('Nhập tên món và giá hợp lệ');customMenu.push({id:Math.max(0,...customMenu.map(x=>x.id))+1,name,price,cat,emoji,desc:'Món ăn được cập nhật bởi quản trị viên.',bg:'green',tag:'MỚI'});localStorage.setItem('tt_custom_menu',JSON.stringify(customMenu));renderFoods();renderAdmin();toast('Đã thêm món vào thực đơn')}
