      <div class="field"><label>Mật khẩu (ít nhất 6 ký tự)</label><input id="gateRegisterPassword" type="password" autocomplete="new-password" minlength="6" placeholder="Tạo mật khẩu" required></div>
      <div class="field"><label>Nhập lại mật khẩu</label><input id="gateRegisterConfirm" type="password" autocomplete="new-password" minlength="6" placeholder="Nhập lại mật khẩu" required></div>
      <label class="remember-row"><input type="checkbox" id="rememberRegister" checked> Ghi nhớ đăng nhập trên thiết bị này</label>
      <button class="primary full" type="submit">Tạo tài khoản và vào trang chủ →</button>
