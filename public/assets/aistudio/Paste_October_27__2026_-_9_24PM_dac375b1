<div id="modalRoot"></div><div id="toastRoot"></div>
<script>
const fmt=n=>new Intl.NumberFormat('vi-VN').format(n)+' ₫';
const defaultPackageCatalog=[{id:'p5',count:5,price:275000,title:'Gói 5 suất ăn',tag:'LINH HOẠT',desc:'Phù hợp lịch ăn trưa linh hoạt trong tuần.',image:'https://images.unsplash.com/photo-1512621776951-a57141f2eefd?auto=format&fit=crop&w=900&q=85'},{id:'p10',count:10,price:530000,title:'Gói 10 suất ăn',tag:'TIẾT KIỆM',desc:'Dành cho khách hàng thường xuyên sử dụng.',image:'https://images.unsplash.com/photo-1546069901-ba9599a7e63c?auto=format&fit=crop&w=900&q=85'},{id:'p20',count:20,price:1040000,title:'Gói 20 suất ăn',tag:'DÀI HẠN',desc:'Chủ động bữa trưa với số suất lớn hơn.',image:'https://images.unsplash.com/photo-1544025162-d76694265947?auto=format&fit=crop&w=900&q=85'}];
function getPackageCatalog(){try{return JSON.parse(localStorage.getItem('tt_package_catalog')||'null')||defaultPackageCatalog}catch{return defaultPackageCatalog}}
const today=new Date();today.setHours(0,0,0,0);
const dayOptions=Array.from({length:7},(_,i)=>{let d=new Date(today);d.setDate(d.getDate()+i+3);return {value:d.toISOString().slice(0,10),label:d.toLocaleDateString('vi-VN',{weekday:'short',day:'2-digit',month:'2-digit'})}});
const foods=[
{id:1,name:'Cơm gà sốt tiêu',cat:'Cơm',price:55000,emoji:'🍗',desc:'Gà áp chảo, sốt tiêu thơm, rau củ theo mùa.',bg:'',tag:'BÁN CHẠY'},
{id:2,name:'Cơm sườn nướng',cat:'Cơm',price:59000,emoji:'🍖',desc:'Sườn nướng đậm vị, cơm nóng và đồ chua.',bg:'pink',tag:'ĐƯỢC YÊU THÍCH'},
{id:3,name:'Cơm cá kho tộ',cat:'Cơm',price:52000,emoji:'🐟',desc:'Cá kho vị nhà làm, rau xanh và canh thanh mát.',bg:'green',tag:'MÓN MỚI'},
{id:4,name:'Cơm gà xé lá chanh',cat:'Cơm',price:50000,emoji:'🍱',desc:'Gà xé mềm thơm lá chanh, ăn kèm rau luộc.',bg:'blue',tag:'NHẸ NHÀNG'},
{id:5,name:'Cơm đậu hũ nấm',cat:'Món chay',price:45000,emoji:'🥦',desc:'Đậu hũ sốt nấm, rau củ tươi và cơm gạo thơm.',bg:'green',tag:'MÓN CHAY'},
{id:6,name:'Cơm bò xào lúc lắc',cat:'Cơm',price:65000,emoji:'🥩',desc:'Bò xào mềm, khoai tây và rau củ cân bằng.',bg:'',tag:'ĐỦ NĂNG LƯỢNG'}
];
let cart=[],orders=JSON.parse(localStorage.getItem('tt_orders')||'[]'),packages=JSON.parse(localStorage.getItem('tt_packages')||'[]'),activeDay=dayOptions[0].value,activeCat='Tất cả',adminTab='overview',customMenu=JSON.parse(localStorage.getItem('tt_custom_menu')||'null')||[...foods];
let customers=JSON.parse(localStorage.getItem('tt_customers')||'[]'),rememberSession=localStorage.getItem('tt_remember_login')==='yes',activeCustomer=rememberSession?JSON.parse(localStorage.getItem('tt_active_customer')||'null'):null;
function save(){localStorage.setItem('tt_orders',JSON.stringify(orders));localStorage.setItem('tt_packages',JSON.stringify(packages))}
function toast(s){let r=document.getElementById('toastRoot');r.innerHTML='<div class="toast">'+s+'</div>';setTimeout(()=>r.innerHTML='',2600)}
function go(page){document.querySelectorAll('[id^="page-"]').forEach(e=>e.classList.add('hidden'));document.getElementById('page-'+page).classList.remove('hidden');document.querySelectorAll('.nav [data-page]').forEach(b=>b.classList.toggle('active',b.dataset.page===page));if(page==='checkout'){let paySel=document.getElementById('payment');if(paySel)delete paySel.dataset.userChanged;renderCart();if(activeCustomer){document.getElementById('customerName').value=activeCustomer.name||'';document.getElementById('customerPhone').value=activeCustomer.phone||'';document.getElementById('address').value=activeCustomer.address||document.getElementById('address').value;renderCart()}}if(page==='orders')renderOrders();if(page==='member'){renderPackageCatalog();renderMembers();}if(page==='admin')renderAdmin();if(page==='account')renderAccount();if(page==='settings')renderCustomerSettings();window.scrollTo({top:0,behavior:'smooth'})}
document.querySelectorAll('.nav [data-page]').forEach(b=>b.addEventListener('click',()=>go(b.dataset.page)));
function card(f){const img=f.imageUrl||({1:'https://images.unsplash.com/photo-1546069901-ba9599a7e63c?auto=format&fit=crop&w=900&q=85',2:'https://images.unsplash.com/photo-1544025162-d76694265947?auto=format&fit=crop&w=900&q=85',3:'https://images.unsplash.com/photo-1519708227418-c8fd9a32b7a2?auto=format&fit=crop&w=900&q=85',4:'https://images.unsplash.com/photo-1547592180-85f173990554?auto=format&fit=crop&w=900&q=85',5:'https://images.unsplash.com/photo-1512621776951-a57141f2eefd?auto=format&fit=crop&w=900&q=85',6:'https://images.unsplash.com/photo-1546833999-b9f581a1996d?auto=format&fit=crop&w=900&q=85'}[f.id]||'https://images.unsplash.com/photo-1546069901-ba9599a7e63c?auto=format&fit=crop&w=900&q=85');return `<article class="foodcard"><div class="foodimg ${f.bg||''}"><img src="${img}" alt="${f.name}" loading="lazy" onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1546069901-ba9599a7e63c?auto=format&fit=crop&w=900&q=85'"><span class="tag">${f.tag||f.cat}</span></div><div class="foodbody"><h3>${f.name}</h3><div class="desc">${f.desc||'Bữa trưa được chuẩn bị tươi ngon mỗi ngày.'}</div><div class="foodfoot"><span class="price">${fmt(f.price)}</span><button class="add" aria-label="Thêm ${f.name}" onclick="addCart(${f.id})">+</button></div></div></article>`}
function renderFoods(){document.getElementById('homeFoods').innerHTML=customMenu.slice(0,3).map(card).join('');document.getElementById('menuFoods').innerHTML=customMenu.filter(f=>activeCat==='Tất cả'||(activeCat==='Cơm'&&['Cơm','Cơm gà','Cơm thịt'].includes(f.cat))||f.cat===activeCat).map(card).join('')||'<div class="empty">Chưa có món trong nhóm này.</div>';document.querySelectorAll('#categoryFilters button').forEach(b=>b.classList.toggle('active',b.dataset.cat===activeCat));}
function renderPackageCatalog(){let el=document.getElementById('packageCatalogCards');if(!el)return;el.innerHTML=getPackageCatalog().map(p=>`<div class="foodcard"><div class="package-img"><img src="${p.image||'https://images.unsplash.com/photo-1546069901-ba9599a7e63c?auto=format&fit=crop&w=900&q=85'}" alt="${p.title}" loading="lazy"></div><div class="foodbody"><span class="pill">${p.tag||'GÓI SUẤT ĂN'}</span><h3>${p.title||('Gói '+p.count+' suất ăn')}</h3><p class="desc">${p.desc||'Gói suất ăn thành viên Tới Trưa.'}</p><div class="foodfoot"><span class="price">${fmt(p.price)}</span><button class="primary" onclick="buyPackage(${Number(p.count)},${Number(p.price)})">Đăng ký</button></div></div></div>`).join('')}
function initDays(){document.getElementById('dayFilters').innerHTML=dayOptions.slice(0,5).map(d=>`<button class="${d.value===activeDay?'active':''}" onclick="setDay('${d.value}')">${d.label}</button>`).join('');document.getElementById('useDay').innerHTML=dayOptions.map(d=>`<option value="${d.value}">${d.label} (${d.value})</option>`).join('')}
function setDay(d){activeDay=d;document.querySelectorAll('#dayFilters button').forEach((b,i)=>b.classList.toggle('active',dayOptions[i].value===d));document.getElementById('useDay').value=d;toast('Đã chọn ngày sử dụng '+d)}
document.querySelectorAll('#categoryFilters button').forEach(b=>b.addEventListener('click',()=>{activeCat=b.dataset.cat;document.querySelectorAll('#categoryFilters button').forEach(x=>x.classList.toggle('active',x===b));renderFoods()}));
function addCart(id){let f=customMenu.find(x=>x.id===id);if(!f)return;let item=cart.find(x=>x.id===id);item?item.qty++:cart.push({...f,qty:1});updateCount();toast('Đã thêm '+f.name+' vào giỏ')}
function updateCount(){document.getElementById('cartCount').textContent=cart.reduce((s,x)=>s+x.qty,0)}
function changeQty(id,n){let x=cart.find(i=>i.id===id);if(x)x.qty+=n;cart=cart.filter(i=>i.qty>0);renderCart();updateCount()}
function shippingFee(){let addr=(document.getElementById('address')?.value||'').toLowerCase();let free=['quận 1','q1','quận 2','q2','quận 3','q3','quận 4','q4','quận 5','q5','quận 10','q10','quận 12','q12','bình thạnh','gò vấp','thủ đức','tân bình','tân phú'];if(!addr||free.some(x=>addr.includes(x)))return 0;return 15000}
function renderCart(){let el=document.getElementById('cartLines');if(!el)return;if(!cart.length){el.innerHTML='<div class="empty"><span>🛍️</span>Giỏ hàng đang trống.<br>Hãy chọn món bạn thích nhé!</div>'}else{el.innerHTML=cart.map(x=>`<div class="cartline"><div><b>${x.name}</b><small>${fmt(x.price)} / suất</small><div class="qty" style="margin-top:7px"><button onclick="changeQty(${x.id},-1)">−</button><b>${x.qty}</b><button onclick="changeQty(${x.id},1)">+</button></div></div><b>${fmt(x.price*x.qty)}</b></div>`).join('')}
let rawSub=cart.reduce((s,x)=>s+x.price*x.qty,0),payment=document.getElementById('payment'),hasPackage=!!(activeCustomer&&packages.some(p=>p.customerId===activeCustomer.id&&(p.balance??p.price)>0));if(payment&&hasPackage&&payment.dataset.userChanged!=='yes')payment.value='Sử dụng gói suất ăn';let discounted=payment?.value==='Sử dụng gói suất ăn',sub=discounted?Math.round(rawSub*.8):rawSub,ship=rawSub?shippingFee():0;document.getElementById('subtotal').textContent=discounted?`${fmt(sub)} (đã giảm 20%)`:fmt(sub);document.getElementById('shipping').textContent=ship?fmt(ship):'Miễn phí';document.getElementById('grandTotal').textContent=fmt(sub+ship);let notice=document.getElementById('mealCardNotice');if(notice)notice.textContent=discounted?'Ưu đãi thành viên: giảm trực tiếp 20% tiền món ăn khi thanh toán bằng gói suất ăn. Phí giao hàng tính riêng.':'Nếu bạn có gói suất ăn, có thể chọn thanh toán bằng thẻ ăn để được giảm 20% tiền món ăn.'}
