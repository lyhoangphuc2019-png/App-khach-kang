function placeOrder(){if(!cart.length)return toast('Giỏ hàng chưa có món ăn');let name=document.getElementById('customerName').value.trim(),phone=document.getElementById('customerPhone').value.trim(),address=document.getElementById('address').value.trim(),payment=document.getElementById('payment').value;if(!name||!phone||!address)return toast('Vui lòng nhập họ tên, số điện thoại và địa chỉ');let rawSub=cart.reduce((s,x)=>s+x.price*x.qty,0),discount=payment==='Sử dụng gói suất ăn'?Math.round(rawSub*.2):0,sub=rawSub-discount,ship=shippingFee(),selectedPackage=null;if(payment==='Sử dụng gói suất ăn'){if(!activeCustomer)return toast('Vui lòng đăng nhập để sử dụng thẻ ăn thành viên');selectedPackage=packages.find(p=>p.customerId===activeCustomer.id&&(p.balance??p.price)>=sub&&((p.used||0)+cart.reduce((a,x)=>a+x.qty,0)<=(p.count||9999)));if(!selectedPackage)return toast('Số dư hoặc số suất còn lại của thẻ ăn không đủ. Hãy chọn gói khác hoặc phương thức thanh toán khác.');if(!confirm(`Xác nhận đặt món sau khi giảm 20%? Trừ ${fmt(sub)} từ thẻ ăn ${activeCustomer.memberCode}. Phí giao hàng ${ship?fmt(ship):'miễn phí'} thanh toán riêng.`))return;selectedPackage.balance=(selectedPackage.balance??selectedPackage.price)-sub;selectedPackage.used=(selectedPackage.used||0)+cart.reduce((a,x)=>a+x.qty,0)}let order={id:'TT'+String(Date.now()).slice(-6),name,phone,address,day:document.getElementById('useDay').value,time:document.getElementById('deliveryTime').value,note:document.getElementById('note').value,payment,customerId:activeCustomer?.id||null,memberCode:activeCustomer?.memberCode||null,packageId:selectedPackage?.id||null,packageCharge:selectedPackage?sub:0,packageQty:selectedPackage?cart.reduce((a,x)=>a+x.qty,0):0,refundProcessed:false,items:cart.map(x=>({...x})),subtotal:rawSub,discount,foodTotal:sub,shipping:ship,total:sub+ship,status:'Chờ xác nhận',payStatus:selectedPackage?'Đã thanh toán bằng thẻ ăn':'Chưa thanh toán',created:new Date().toISOString()};orders.unshift(order);save();cart=[];updateCount();toast(selectedPackage?'Đặt món thành công, đã giảm 20% và trừ '+fmt(sub)+' từ thẻ ăn':'Đặt trước thành công! Mã đơn '+order.id);go('orders')}
function statusClass(s){return s==='Đã hủy'||s==='Giao thất bại'?'cancel':s==='Chờ xác nhận'||s==='Đang chuẩn bị'?'wait':''}
function renderOrders(){let el=document.getElementById('customerOrders');if(!orders.length){el.innerHTML='<div class="empty"><span>📦</span>Bạn chưa có đơn hàng nào.</div>';return}el.innerHTML='<div class="tablewrap"><table class="data"><thead><tr><th>Mã đơn</th><th>Ngày sử dụng</th><th>Món ăn</th><th>Tổng tiền</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>'+orders.map(o=>`<tr><td><b>${o.id}</b><br><small>${o.name}</small></td><td>${o.day}<br><small>${o.time}</small></td><td>${o.items.map(i=>i.name+' × '+i.qty).join('<br>')}</td><td><b>${fmt(o.total)}</b></td><td><span class="status ${statusClass(o.status)}">${o.status}</span><br><small>${o.payStatus}</small></td><td>${o.status!=='Đã hủy'&&canCancel(o)?`<button class="smallbtn danger" onclick="cancelOrder('${o.id}')">Hủy đơn</button>`:'—'}</td></tr>`).join('')+'</tbody></table></div><p style="font-size:12px;color:var(--muted)">Theo quy định mô phỏng, đơn ăn trong ngày chỉ được hủy trước 07:00 sáng ngày sử dụng.</p>'}
