function cancelOrder(id){let o=orders.find(x=>x.id===id);if(!o)return;let d=new Date(o.day+'T07:00:00');if(o.day===new Date().toISOString().slice(0,10)&&new Date()>=d){toast('Đã quá 07:00, vui lòng liên hệ quản trị viên');return}if(confirm('Bạn muốn hủy đơn '+id+'? Nếu đã thanh toán, hệ thống demo sẽ hoàn tiền theo phương thức đã dùng.')){o.status='Đã hủy';if(!o.refundProcessed){if(o.packageId){let p=packages.find(x=>x.id===o.packageId);if(p){p.balance=(Number(p.balance)||0)+(Number(o.packageCharge)||Number(o.foodTotal)||Number(o.subtotal)||0);p.used=Math.max(0,(Number(p.used)||0)-(Number(o.packageQty)||((o.items||[]).reduce((a,i)=>a+(Number(i.qty)||0),0))));o.payStatus='Đã hoàn tiền vào thẻ ăn'}}else if(o.payStatus==='Đã thanh toán'||String(o.payStatus||'').includes('Đã thanh toán'))o.payStatus='Đã hoàn tiền (mô phỏng)';o.refundProcessed=true}save();renderOrders();toast('Đơn đã hủy; tiền thẻ ăn đã được hoàn lại nếu có phát sinh')}}
function buyPackage(count,price){if(!activeCustomer){toast('Vui lòng đăng nhập hoặc đăng ký tài khoản trước khi mua gói suất ăn');go('account');return}if(confirm(`Đăng ký gói ${count} suất ăn với giá ${fmt(price)} cho mã thành viên ${activeCustomer.memberCode}? (Thanh toán mô phỏng)`)){packages.push({id:'GOI'+Date.now().toString().slice(-5),customerId:activeCustomer.id,memberCode:activeCustomer.memberCode,count,used:0,price,balance:price,created:new Date().toLocaleDateString('vi-VN')});save();renderMembers();renderAccount();toast('Đã đăng ký gói suất ăn cho mã thành viên '+activeCustomer.memberCode)}}
function renderMembers(){let el=document.getElementById('memberInfo');let own=activeCustomer?packages.filter(p=>p.customerId===activeCustomer.id):[];if(!activeCustomer){el.innerHTML='<div class="empty"><span>🔐</span>Đăng nhập để đăng ký và xem các gói suất ăn gắn với mã thành viên riêng của bạn.</div>';return}if(!own.length){el.innerHTML='<div class="empty"><span>🎟️</span>Mã thành viên của bạn: <b>'+activeCustomer.memberCode+'</b><br>Bạn chưa có gói suất ăn. Chọn một gói phía trên để đăng ký.</div>';return}el.innerHTML='<div class="notice">Mã thành viên: <b>'+activeCustomer.memberCode+'</b>. Khi thanh toán bằng thẻ ăn, tiền món ăn sẽ được trừ tự động sau khi xác nhận đặt món.</div>'+own.map(p=>`<div style="padding:16px 0;border-bottom:1px solid var(--line)"><div style="display:flex;justify-content:space-between;gap:10px"><div><b>${p.count} suất ăn · ${p.id}</b><div style="color:var(--muted);font-size:12px">Đăng ký: ${p.created} · Giá gói ban đầu: ${fmt(p.price)}</div><div style="font-size:13px;margin-top:5px">Số dư thẻ ăn: <b>${fmt(p.balance??p.price)}</b></div></div><span class="pill">ĐÃ DÙNG ${p.used||0} SUẤT</span></div><div class="reportbar"><i style="width:${Math.min(100,((p.balance??p.price)/p.price)*100)}%"></i></div></div>`).join('')}
